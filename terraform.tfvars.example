# Copy to terraform.tfvars and replace only the values appropriate for your Azure subscription.
# terraform.tfvars is intentionally ignored by Git.
location     = "centralindia"
project_name = "aksops"
environment  = "dev"

# The current Central India subscription quota supports two D2s_v5 nodes.
# Set to 3 only after obtaining sufficient regional vCPU quota.
node_count   = 2
node_vm_size = "Standard_D2s_v5"

# Azure Managed Grafana Standard is optional and incurs recurring cost.
enable_managed_grafana = false

# Use a dedicated kubeconfig for the target AKS cluster; do not rely on the
# current/default kubectl context.
kubeconfig_path = "/tmp/azure-aks-gitops-observability.kubeconfig"

alert_email = "your-email@example.com"
